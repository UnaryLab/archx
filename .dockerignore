# Keep the build context lean and source-only (mirrors .gitignore intent).
.git
.gitignore
.claude/
.vscode/

# Python / Rust build artifacts (rebuilt inside the image)
**/__pycache__/
*.py[codz]
*.so
target/
src/archx/rust-core/target/
*.egg-info/
build/
dist/

# Generated case-study data (regenerated by agraph/agraph.sh in the container)
agraph/designs/*/description/
agraph/designs/*/results/
agraph/res/figures/
agraph/res/csv/

# Design removed from the artifact but kept locally
agraph/designs/gpu_qwen2_5/

# Interface copies registered into the framework (re-registered at run time;
# the tracked source of truth is agraph/interface/)
src/archx/interface/cacti7/
src/archx/interface/csv_cmos/
src/archx/interface/csv_sc/
src/archx/interface/csv_riscv/
src/archx/interface/csv_h200/
